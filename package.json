{
  "name": "setvia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --import tsx server/src/index.ts",
    "start:server": "node --import tsx server/src/index.ts",
    "build": "npm run check:server && tsc -b && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1",
    "check:server": "tsc --noEmit -p server/tsconfig.json",
    "test": "tsx --test server/src/ai/ai.test.ts server/src/ai/muse-image.test.ts server/src/http/app.test.ts client/plan-api.test.ts client/plan-mapping.test.ts client/draft-store.test.ts client/frontend-preview.test.ts server/src/agents/agents.test.ts scripts/live-budget-journal.test.ts lab-ui/server.test.ts server/src/dashboard/dashboard.test.ts client/dashboard/dashboard.test.ts server/src/rooms/runtime.test.ts server/src/rooms/receipt-image.test.ts server/src/synthetic/synthetic.test.ts server/src/storage-seed.test.ts shared/room-code.test.ts client/dashboard/beach-trip-demo.test.ts client/dashboard/decision-receipt.test.ts server/src/playground/playground.test.ts",
    "test:playground": "tsx --test server/src/playground/playground.test.ts",
    "test:dashboard": "tsx --test server/src/dashboard/dashboard.test.ts client/dashboard/dashboard.test.ts",
    "lab": "tsx scripts/run-lab.ts",
    "lab:live": "node --env-file-if-exists=.env --import tsx scripts/run-lab-live.ts",
    "lab:review": "node --env-file-if-exists=.env --import tsx scripts/review-lab.ts",
    "demo:studio": "node --env-file-if-exists=.env --import tsx scripts/demo-studio.ts",
    "lab:ui:build": "vite build --config lab-ui/vite.config.ts --configLoader runner",
    "lab:ui": "npm run lab:ui:build && tsx lab-ui/server.ts",
    "test:meta": "node --env-file-if-exists=.env --import tsx scripts/test-meta.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lexend": "latest",
    "clsx": "latest",
    "express": "^5.3.0",
    "lucide-react": "latest",
    "motion": "^14.9.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "tailwind-merge": "latest",
    "uisfx": "^0.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.10",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vite": "latest"
  }
}
